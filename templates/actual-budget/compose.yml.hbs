services:
  actual-budget:
    image: actualbudget/actual-server:24.11.0
    container_name: {{stack_name}}
    restart: unless-stopped
    mem_limit: {{mem_limit}}
    pids_limit: {{pids_limit}}
    security_opt:
      - no-new-privileges:true
    volumes:
      - ./data:/data
    healthcheck:
      test: ["CMD-SHELL", "node src/scripts/health-check.js || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
    networks:
      - proxy

networks:
  proxy:
    external: true
