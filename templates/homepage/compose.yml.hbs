services:
  homepage:
    image: ghcr.io/gethomepage/homepage:v0.9.11
    container_name: {{stack_name}}
    restart: unless-stopped
    mem_limit: {{mem_limit}}
    pids_limit: {{pids_limit}}
    security_opt:
      - no-new-privileges:true
    environment:
      HOMEPAGE_ALLOWED_HOSTS: {{hostname}}
    volumes:
      - ./config:/app/config
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:3000/api/healthcheck >/dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
    networks:
      - proxy

networks:
  proxy:
    external: true
