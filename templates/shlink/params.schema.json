{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shlink",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stack_name": { "type": "string", "default": "shlink", "pattern": "^[a-z0-9-]+$" },
    "hostname": { "type": "string", "default": "go.example.com" },
    "mem_limit": { "type": "string", "default": "256m" },
    "pids_limit": { "type": "integer", "default": 128 }
  },
  "secrets": ["SHLINK_INITIAL_API_KEY"]
}
