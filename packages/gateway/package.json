{
  "name": "@homemcp/gateway",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "homemcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true});\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@homemcp/agent": "workspace:*",
    "@homemcp/connectors": "workspace:*",
    "@homemcp/core": "workspace:*",
    "@homemcp/mock": "workspace:*",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@simplewebauthn/server": "^14.1.0",
    "express": "^5.3.0",
    "jose": "^6.2.18",
    "oidc-provider": "^9.15.1",
    "otplib": "^12.0.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/oidc-provider": "^9.13.1",
    "@types/qrcode": "^1.5.5"
  }
}
