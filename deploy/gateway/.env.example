# Copy to .env with mode 0600 and fill real values on the server.
HOMEMCP_SECRET_KEY=replace-with-64-hex-chars
HOMEMCPD_HMAC_SECRET=replace-with-agent-hmac-secret
NPM_EMAIL=homemcp@example.com
NPM_PASSWORD=replace-with-npm-password
CF_ACCOUNT_ID=replace-with-cf-account-id
CF_TUNNEL_ID=replace-with-cf-tunnel-id
CF_API_TOKEN=replace-with-cf-api-token
NAVIDROME_USER=owner
NAVIDROME_PASSWORD=replace-with-navidrome-password
NAVILOAD_TOKEN=replace-with-naviload-token
JELLYFIN_API_KEY=replace-with-jellyfin-api-key
QBIT_USER=admin
QBIT_PASSWORD=replace-with-qbit-password
JACKETT_API_KEY=replace-with-jackett-api-key
NTFY_URL=https://ntfy.sh/replace-with-private-topic
NTFY_TOKEN=
HC_URL_HOMEMCP=
